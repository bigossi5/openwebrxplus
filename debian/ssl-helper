#!/bin/bash
#
# Root helper behind Settings -> General -> HTTPS.
#
# The web service runs as the unprivileged "openwebrx" user, which cannot write
# /etc/openwebrx or run certbot, so it calls this script through a narrow sudo
# rule (see debian/openwebrx.postinst). Arguments are validated strictly before
# anything privileged happens, and the script never evals or expands them.
#
#   ssl-helper selfsigned <hostname> [ipv4|ipv6 ...]
#   ssl-helper letsencrypt <fqdn> [email]
#   ssl-helper deploy <fqdn>          (certbot deploy hook, not called via sudo)
#   ssl-helper disable
#
set -euo pipefail

CERT="/etc/openwebrx/cert.pem"
KEY="/etc/openwebrx/key.pem"
SERVICE_USER="openwebrx"
SELF="/usr/lib/openwebrx/ssl-helper"

HOST_RE='^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$'
FQDN_RE='^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$'
EMAIL_RE='^[A-Za-z0-9._%+-]+@([A-Za-z0-9-]+\.)+[A-Za-z]{2,63}$'
IPV4_RE='^([0-9]{1,3}\.){3}[0-9]{1,3}$'
IPV6_RE='^[0-9A-Fa-f:]{2,45}$'

fail() {
  echo "ssl-helper: $1" >&2
  exit "${2:-2}"
}

matches() {
  [[ "$1" =~ $2 ]]
}

check_host() {
  matches "$1" "$HOST_RE" || fail "invalid host name"
}

check_fqdn() {
  matches "$1" "$FQDN_RE" || fail "invalid domain name"
}

check_email() {
  matches "$1" "$EMAIL_RE" || fail "invalid e-mail address"
}

check_ip() {
  if matches "$1" "$IPV4_RE" || matches "$1" "$IPV6_RE"; then
    return 0
  fi
  fail "invalid IP address"
}

# ---- argument validation (runs before the root check, so it can be tested) ----

cmd="${1:-}"
case "$cmd" in
  selfsigned)
    [ $# -ge 2 ] || fail "usage: selfsigned <hostname> [ip ...]"
    check_host "$2"
    for ip in "${@:3}"; do
      check_ip "$ip"
    done
    ;;
  letsencrypt)
    if [ $# -lt 2 ] || [ $# -gt 3 ]; then
      fail "usage: letsencrypt <fqdn> [email]"
    fi
    check_fqdn "$2"
    if [ $# -eq 3 ]; then
      check_email "$3"
    fi
    ;;
  deploy)
    [ $# -eq 2 ] || fail "usage: deploy <fqdn>"
    check_fqdn "$2"
    ;;
  disable)
    [ $# -eq 1 ] || fail "usage: disable"
    ;;
  *)
    fail "usage: ssl-helper selfsigned|letsencrypt|deploy|disable ..."
    ;;
esac

[ "$(id -u)" -eq 0 ] || fail "must run as root" 3

# ---- actions ----

install_pair() {
  install -d -o root -g root -m 0755 "$(dirname "$CERT")"
  install -o root -g root -m 0644 "$1" "$CERT"
  install -o root -g "$SERVICE_USER" -m 0640 "$2" "$KEY"
}

# The certificate is only read at startup, so the service must restart. Do it
# from a delayed transient unit: restarting synchronously would kill the web
# process that is still waiting for this script to finish. The fixed unit name
# collapses repeated requests (e.g. certbot hook + explicit deploy) into one.
schedule_restart() {
  systemd-run --quiet --unit=openwebrx-ssl-restart --on-active=3 \
    /bin/systemctl restart openwebrx || true
}

deploy_letsencrypt() {
  local live="/etc/letsencrypt/live/$1"
  [ -f "$live/fullchain.pem" ] && [ -f "$live/privkey.pem" ] || \
    fail "no Let's Encrypt certificate found for $1" 5
  install_pair "$live/fullchain.pem" "$live/privkey.pem"
  schedule_restart
}

case "$cmd" in
  selfsigned)
    command -v openssl >/dev/null || fail "openssl is not installed" 4
    cn="$2"
    san="DNS:$cn"
    for ip in "${@:3}"; do
      san="$san,IP:$ip"
    done
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days 3650 \
      -keyout "$tmp/key.pem" -out "$tmp/cert.pem" \
      -subj "/CN=$cn" -addext "subjectAltName=$san" >/dev/null 2>&1 || \
      fail "could not generate the certificate" 6
    install_pair "$tmp/cert.pem" "$tmp/key.pem"
    schedule_restart
    echo "self-signed certificate installed for $cn"
    ;;
  letsencrypt)
    command -v certbot >/dev/null || fail "certbot is not installed (sudo apt install certbot)" 4
    args=(certonly --standalone --non-interactive --agree-tos --keep-until-expiring
          -d "$2" --deploy-hook "$SELF deploy $2")
    if [ $# -eq 3 ]; then
      args+=(--email "$3")
    else
      args+=(--register-unsafely-without-email)
    fi
    certbot "${args[@]}" || fail "certbot failed (is port 80 free and reachable from the internet?)" 7
    # certbot skips the deploy hook when it keeps a still-valid certificate
    deploy_letsencrypt "$2"
    echo "Let's Encrypt certificate installed for $2"
    ;;
  deploy)
    deploy_letsencrypt "$2"
    ;;
  disable)
    rm -f "$CERT" "$KEY"
    schedule_restart
    echo "HTTPS disabled"
    ;;
esac
